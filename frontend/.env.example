# Backend origin used by the browser. Never put backend secrets here.
#
# Local development only. Copy to `.env.local`:
#   VITE_API_BASE_URL=http://localhost:4000
#
# Leave this UNSET in Vercel production. There, requests go same-origin to
# `/api/*` and `vercel.json` proxies them to Render. Pointing this at the
# Render URL in production would make the session cookie third-party and
# break login in Safari and private windows.
VITE_API_BASE_URL=http://localhost:4000
