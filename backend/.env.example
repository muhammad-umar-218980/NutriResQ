# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL / Neon. Only the backend reads this; never expose it to the browser.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Session cookie signing is not needed (opaque tokens), but a secret is used to
# hash verification/reset tokens together with a per-row salt.
SESSION_TOKEN_PEPPER=replace-with-at-least-32-random-characters

# Single seeded administrator. No admin registration page exists.
ADMIN_EMAIL=admin@nutriresq.local
ADMIN_PASSWORD=ChangeMe-Admin-2026

# Password for the seeded donor/recipient/delivery demo accounts.
DEMO_PASSWORD=Demo-Pass-2026

# Optional: enables database integration tests against an isolated schema.
# DATABASE_URL_TEST=postgresql://user:password@host/dbname?sslmode=require
# TEST_SCHEMA=nutriresq_test
